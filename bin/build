#!/usr/bin/env sh
# Configure (once) and build into build/. Run from anywhere.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cmake -S "$ROOT" -B "$ROOT/build" -G Ninja -DCMAKE_BUILD_TYPE=Release >/dev/null
cmake --build "$ROOT/build"
echo "Built: $(find "$ROOT/build" -maxdepth 1 -type f -executable | head -1)"
