# Copy to `.env` beside this file and fill in. `.env` is gitignored.
#
# The same file serves two jobs: applying the migrations from a workstation,
# and running the container on the NAS. Container Manager reads a `.env` from
# the project folder, so the deployment half is uploaded beside compose.yaml
# and the rest is ignored there.

# --- The database -----------------------------------------------------------

# Postgres runs on the NAS as the `postgres` container, published on 5433 — the
# container's own 5432 is mapped up one. Reachable over the tailnet only.
PLANNER_DB_HOST=nas.example.ts.net
PLANNER_DB_PORT=5433
PLANNER_DB_NAME=planner
PLANNER_DB_USER=planner

# Generate one with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
#
# Set it with server/migrations/0001-init.sql, which takes it as a psql
# variable so it is never written into a file that git tracks. Re-running that
# migration with a different value changes the password.
PLANNER_DB_PASSWORD=

# The superuser, used only to apply migrations and never by the server itself.
# It is `postgres` on this instance, and its password is whatever the `postgres`
# container's POSTGRES_PASSWORD environment variable says — Container Manager →
# Container → postgres → Details shows it.
#
# It lives here rather than being typed onto a psql command line so that it
# stays out of shell history and process listings.
PLANNER_DB_SUPERUSER=postgres
PLANNER_DB_SUPERUSER_PASSWORD=

# --- Deployment -------------------------------------------------------------

# Where Container Manager pulls the image from — whatever the deploy script
# printed when it pushed.
#
# Say "localhost" even though the push went to the NAS's tailnet name. A
# registry stores repositories by name and not by hostname, so it is the same
# image, and Docker accepts a registry reached over localhost on plain HTTP
# without being configured to. Naming the NAS instead means editing the Docker
# daemon config over SSH for no gain.
#
# Pin the dated tag rather than :latest, so a restart cannot quietly change
# what is holding the task list.
PLANNER_SERVER_IMAGE=localhost:5050/planner-server:2026-08-04

# 32 characters or more, or the server refuses to start. The only thing between
# the tailnet and the task list.
#     openssl rand -hex 32
PLANNER_SERVER_TOKEN=

# Which interface to listen on. Leave unset for all of them; set it to the
# NAS's Tailscale address to be reachable only over the tailnet, which is the
# arrangement this is built for — it speaks plain HTTP, so on a LAN both the
# token and the tasks travel in clear text.
#     tailscale ip -4
# PLANNER_BIND=100.x.y.z
